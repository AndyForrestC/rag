# Production Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ===============================
# Application Configuration
# ===============================
NODE_ENV=production
ENVIRONMENT=production
DEBUG=false

# ===============================
# Service URLs
# ===============================
INGESTION_SERVICE_URL=http://ingestion-service:8000
INFERENCE_BACKEND_URL=http://inference-backend:8001
FRONTEND_URL=http://localhost:3000

# ===============================
# Database Configuration
# ===============================
# Milvus Vector Database
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_USERNAME=""
MILVUS_PASSWORD=""
MILVUS_DATABASE=rag_db
MILVUS_COLLECTION=documents

# Redis Cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
REDIS_MAX_CONNECTIONS=10

# ===============================
# AI/ML Configuration
# ===============================
# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# Cohere (optional)
COHERE_API_KEY=your_cohere_api_key_here
COHERE_MODEL=command-xlarge-nightly

# Hugging Face (optional)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_MODEL=sentence-transformers/all-MiniLM-L6-v2

# NeMo Guardrails Configuration
GUARDRAILS_ENABLED=true
GUARDRAILS_CONFIG_PATH=/app/config/guardrails

# ===============================
# Security Configuration
# ===============================
# JWT Secret for authentication
JWT_SECRET=your_jwt_secret_key_here_make_it_long_and_secure
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# API Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10
RATE_LIMIT_ENABLED=true

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "https://your-domain.com"]
CORS_CREDENTIALS=true

# ===============================
# File Processing Configuration
# ===============================
# Upload limits
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=["pdf", "txt", "doc", "docx", "md"]
UPLOAD_DIRECTORY=/tmp/uploads

# Text Processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MIN_CHUNK_SIZE=100

# ===============================
# Monitoring Configuration
# ===============================
# Prometheus
PROMETHEUS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics

# Health Checks
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=JSON
LOG_MAX_SIZE=100MB
LOG_RETENTION_DAYS=30

# ===============================
# Performance Configuration
# ===============================
# Worker Configuration
WORKER_PROCESSES=4
WORKER_CONNECTIONS=1000
WORKER_TIMEOUT=30

# Cache Configuration
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# Batch Processing
BATCH_SIZE=10
MAX_CONCURRENT_REQUESTS=100

# ===============================
# Docker Configuration
# ===============================
# Registry settings
DOCKER_REGISTRY=docker.io
DOCKER_NAMESPACE=your_dockerhub_username
IMAGE_TAG=latest

# Container Resources
MEMORY_LIMIT=2g
CPU_LIMIT=2
MEMORY_RESERVATION=1g
CPU_RESERVATION=1

# ===============================
# CI/CD Configuration
# ===============================
# GitHub Actions (set these as GitHub Secrets, not in .env file)
# DOCKER_USERNAME=your_dockerhub_username
# DOCKER_PASSWORD=your_dockerhub_password
# SONAR_TOKEN=your_sonarcloud_token

# Deployment Configuration
DEPLOYMENT_STRATEGY=rolling
DEPLOYMENT_TIMEOUT=300
ROLLBACK_ENABLED=true

# ===============================
# Domain and SSL
# ===============================
DOMAIN_NAME=your-domain.com
SSL_ENABLED=true
CERT_EMAIL=your-email@domain.com
FORCE_HTTPS=true

# ===============================
# Notification Configuration
# ===============================
# Email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@your-domain.com

# Slack notifications (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_CHANNEL=#alerts

# ===============================
# Backup Configuration
# ===============================
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=7
BACKUP_STORAGE_PATH=/backups

# ===============================
# Testing Configuration
# ===============================
# Test Database
TEST_MILVUS_HOST=localhost
TEST_MILVUS_PORT=19530
TEST_REDIS_HOST=localhost
TEST_REDIS_PORT=6379

# Test API Keys (use test/sandbox keys)
TEST_OPENAI_API_KEY=your_test_openai_api_key
TEST_COHERE_API_KEY=your_test_cohere_api_key

# Performance Testing
LOAD_TEST_DURATION=5m
LOAD_TEST_VUS=10
LOAD_TEST_STAGES=3
