services:
  ingestion-service-test:
    build:
      context: ./ingestion-service # Corrected context path
      dockerfile: Dockerfile
    ports:
      - "8003:8000" # Use different port for test to avoid conflict
    environment:
      - MODEL=${MODEL:-gpt-3.5-turbo-0125}
      - OPENAI_API_KEY=${OPENAI_API_KEY}
      - MILVUS_API_KEY=${MILVUS_API_KEY}
      - MILVUS_URI=${MILVUS_URI}
      - MILVUS_COLLECTION=${MILVUS_COLLECTION:-rag}
      - MILVUS_DIMENSION=${MILVUS_DIMENSION:-1536}
      - COHERE_API_KEY=${COHERE_API_KEY}
    volumes:
      - ./ingestion-service:/app # Corrected volume path
      - ./data:/app/data # Corrected volume path
    # depends_on:
    #   - redis-test # Keep if redis is still used
    networks:
      - rag_test_network
    restart: unless-stopped

  inference-backend-test:
    build:
      context: ./inference-service/backend # Corrected context path
      dockerfile: Dockerfile
    ports:
      - "8002:8000" # Use different port for test
    environment:
      - MODEL=${MODEL:-gpt-3.5-turbo-0125}
      - OPENAI_API_KEY=${OPENAI_API_KEY}
      - MILVUS_API_KEY=${MILVUS_API_KEY}
      - MILVUS_URI=${MILVUS_URI}
      - MILVUS_COLLECTION=${MILVUS_COLLECTION:-rag}
      - MILVUS_DIMENSION=${MILVUS_DIMENSION:-1536}
      - COHERE_API_KEY=${COHERE_API_KEY}
    volumes:
      - ./inference-service/backend:/app # Corrected volume path
    # depends_on:
    #   - redis-test # Keep if redis is still used
    networks:
      - rag_test_network
    restart: unless-stopped

  inference-frontend-test:
    build:
      context: ./inference-service/frontend # Corrected context path
      dockerfile: Dockerfile
    ports:
      - "3001:3000" # Use different port for test
    environment:
      - NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL:-http://localhost:8002}
    # depends_on:
    #   - inference-backend-test
    networks:
      - rag_test_network
    restart: unless-stopped

