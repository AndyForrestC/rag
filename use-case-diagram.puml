@startuml Enterprise_RAG_System_Use_Case_Diagram

!theme plain
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
    BackgroundColor #E6F3FF
    BorderColor #4169E1
    FontSize 10
}
skinparam package {
    BackgroundColor #F8F9FA
    BorderColor #4169E1
    FontStyle bold
    FontSize 11
}
skinparam actor {
    FontSize 11
    FontStyle bold
}

title Enterprise RAG System - Use Case Overview

' Improved actor positioning
left to right direction

' Primary actors - better positioning
actor "End User" as EU #90EE90
actor "Knowledge Manager" as KM #FFB6C1
actor "Content Manager" as CM #FFA07A  
actor "System Administrator" as SA #F0E68C

' Streamlined system layout
package "Enterprise RAG Platform" as MAIN {
    
    ' Core functionality
    package "Knowledge Query & Chat" #E6F3FF {
        (Ask Questions) as UC1
        (Receive AI Answers) as UC2  
        (Stream Real-time Responses) as UC3
        (Maintain Chat Sessions) as UC4
        (Export Chat History) as UC5
        (Search Previous Conversations) as UC6
        (Rate Answer Quality) as UC7
    }
    
    ' Content operations
    package "Document Management" #F0FFF0 {
        (Upload Documents) as UC8
        (Organize Document Collections) as UC9
        (Update Document Content) as UC10
        (Delete Outdated Documents) as UC11
        (View Document Status) as UC12
        (Manage Document Access) as UC13
        (Bulk Import Documents) as UC14
    }
    
    ' Quality control  
    package "Content & Quality Control" #FFF0F5 {
        (Review Content Quality) as UC21
        (Moderate AI Responses) as UC22
        (Configure Content Filters) as UC23
        (Approve Document Publications) as UC24
        (Set Content Guidelines) as UC25
        (Monitor Content Compliance) as UC26
    }
    
    ' System administration
    package "User & Access Management" #FFFACD {
        (User Authentication) as UC15
        (Manage User Permissions) as UC16
        (Control Document Access) as UC17
        (Monitor User Activities) as UC18
        (Configure System Settings) as UC19
        (Manage User Groups) as UC20
    }
    
    ' Analytics
    package "Analytics & Reporting" #F5F5DC {
        (View Usage Analytics) as UC27
        (Generate System Reports) as UC28
        (Monitor Performance Metrics) as UC29
        (Track User Engagement) as UC30
        (Analyze Query Patterns) as UC31
        (Export Analytics Data) as UC32
    }
}

' External systems
package "External Systems" #FFE4E1 {
    (OpenAI API) as EXT1
    (Milvus Vector Database) as EXT2
    (Authentication Provider) as EXT3
    (Content Moderation Service) as EXT4
}

' Essential actor relationships - simplified
EU --> UC1 : asks questions
EU --> UC2 : receives answers
EU --> UC3 : real-time chat
EU --> UC4 : manages sessions
EU --> UC7 : provides feedback

KM --> UC8 : uploads documents
KM --> UC9 : organizes content
KM --> UC10 : updates content
KM --> UC12 : monitors status
KM --> UC14 : bulk operations

CM --> UC21 : reviews quality
CM --> UC22 : moderates responses
CM --> UC23 : configures filters
CM --> UC24 : approves publications
CM --> UC25 : sets guidelines

SA --> UC15 : manages authentication
SA --> UC16 : controls permissions
SA --> UC18 : monitors activities
SA --> UC19 : configures system
SA --> UC27 : views analytics
SA --> UC28 : generates reports

' Key system integrations
UC1 --> EXT1 : AI processing
UC2 --> EXT1 : response generation
UC1 --> EXT2 : vector search
UC8 --> EXT2 : stores embeddings
UC15 --> EXT3 : authentication
UC22 --> EXT4 : content moderation

' Critical process flows
UC8 --> UC12 : processing status
UC1 --> UC2 : triggers response
UC2 --> UC22 : applies moderation
UC15 --> UC16 : enables permissions
UC21 --> UC22 : influences rules

note top of MAIN
  Enterprise RAG system for intelligent
  document search and AI-powered Q&A
end note

note right of EU
  Primary users: employees,
  customers, knowledge workers
end note

@enduml
